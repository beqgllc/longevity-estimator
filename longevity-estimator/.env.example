# Copy to .env.local for local development if these variables are used.
# Never commit .env.local or real secret values. NEXT_PUBLIC_* values are exposed to browsers.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Longevity Estimator"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging must never include raw questionnaire answers or sensitive feature values.
LOG_LEVEL=info

# Privacy-safe defaults. The application must enforce these values in code.
ENABLE_ANALYTICS=false
PERSIST_ASSESSMENTS=false
ALLOW_LOCAL_DRAFT_STORAGE=false

# Baseline/model providers must be explicitly configured. Leave unset until approved sources
# and validated models have been integrated and their metadata reviewed.
MORTALITY_DATA_PROVIDER=none
MORTALITY_DATA_VERSION=
MORTALITY_DATA_PATH=
SURVIVAL_MODEL_PROVIDER=none
SURVIVAL_MODEL_ID=
SURVIVAL_MODEL_VERSION=

# Optional server-side feature switches. Keep secrets out of NEXT_PUBLIC_* variables.
# Do not add credentials here; use the hosting provider's secret manager for real secrets.
